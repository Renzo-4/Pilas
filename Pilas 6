#Metodo FIFO


#  Creamos una cola vacía
cola_nombres = []

#  Función para agregar nombres a la cola (primero en entrar, primero en salir)
def agregar_nombres():
    print("🔹 Agregue 5 nombres:")
    for i in range(5):
        nombre = input(f"Ingrese el nombre #{i+1}: ")
        cola_nombres.append(nombre)
        print(f" Nombre '{nombre}' agregado a la cola.")

# Función para eliminar el primer nombre ingresado (FIFO)
def sacar_nombre():
    print("\n🔸 Eliminando el primer nombre ingresado (FIFO)...")
    if cola_nombres:
        nombre = cola_nombres.pop(0)
        print(f" Nombre '{nombre}' eliminado de la cola.")
    else:
        print(" La cola está vacía. No hay nada que eliminar.")

#  Función para mostrar el contenido actual de la cola
def mostrar_cola():
    print("\n Contenido actual de la cola (de primero a último):")
    if cola_nombres:
        for i, nombre in enumerate(cola_nombres, 1):
            print(f"{i}. {nombre}")
    else:
        print(" La cola está vacía.")

#  Ejecución del programa
agregar_nombres()
mostrar_cola()
sacar_nombre()
mostrar_cola()
