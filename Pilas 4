pilaFia = []
pilaFia2 = []

# Push inicial
for i in range(1, 16):
    pilaFia.append(i)

print("Pila inicial:", pilaFia)

# Números a eliminar
numeros_a_eliminar = [3, 7]

# Eliminar cada número
for numero in numeros_a_eliminar:
    while pilaFia:
        temp = pilaFia.pop()
        if temp == numero:
            print(f"¡Número {numero} eliminado!")
            break
        else:
            pilaFia2.append(temp)

    # Restaurar los elementos en el orden original
    while pilaFia2:
        pilaFia.append(pilaFia2.pop())

print("Pila final (sin los números eliminados):", pilaFia)





# Restaurar los elementos en el orden original
while pilaFia2:
    pilaFia.append(pilaFia2.pop())

print("Pila restaurada (sin el número eliminado):", pilaFia)
