# Creamos una pila vacía
pila_nombres = []

# Función para agregar nombres
def agregar_nombres():
    print("Agregue 5 nombres:")
    for i in range(5):
        nombre = input(f"Ingrese el nombre #{i+1}: ")
        pila_nombres.append(nombre)
        print(f"Nombre '{nombre}' agregado a la pila.")

# Función para sacar el último nombre ingresado
def sacar_nombre():
    print("Elimine un nombre")
    if pila_nombres:
        nombre = pila_nombres.pop()
        print(f"Nombre '{nombre}' eliminado de la pila.")
    else:
        print("La pila está vacía.")

# Función para mostrar la pila
def mostrar_pila():
    print("\nContenido actual de la pila (LIFO):")
    if pila_nombres:
        for i, nombre in enumerate(reversed(pila_nombres), 1):
            print(f"{i}. {nombre}")
    else:
        print("La pila está vacía.")

# Ejecución
agregar_nombres()
mostrar_pila()
sacar_nombre()
mostrar_pila()
